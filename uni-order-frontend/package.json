{
  "name": "uniorder-frontend",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "turbo": "^2.0.0"
  },
  "scripts": {
    "dev:customer": "pnpm --filter customer-web-app dev",
    "dev:merchant": "pnpm --filter merchant-portal dev",
    "dev:shipper": "pnpm --filter shipper-app dev",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "api-generator": "tsx --env-file=.env packages/api/src/sync-api.ts"
  },
  "packageManager": "pnpm@9.0.0"
}