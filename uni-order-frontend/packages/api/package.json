{
    "name": "@uniorder/api",
    "version": "0.0.0",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": {
            "types": "./src/*.ts",
            "default": "./src/*.ts"
        },
        "./generated/*": {
            "types": "./src/generated/*/index.ts",
            "default": "./src/generated/*/index.ts"
        }
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "generate:component": "turbo gen react-component",
        "check-types": "tsc --noemit"
    },
    "devdependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.20",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "axios": "^1.17.0",
        "child_process": "^1.0.2",
        "eslint": "^9.39.1",
        "fs": "0.0.1-security",
        "globals": "^17.6.0",
        "path": "^0.12.7",
        "typescript": "5.9.2",
        "typescript-eslint": "^8.60.1",
        "url": "^0.11.4"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
