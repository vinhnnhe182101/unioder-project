{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        // 🌟 Điểm neo từ thư mục chứa tsconfig
        "paths": {
            "@/*": [
                "./src/*"
            ]
            // 🌟 Giúp định tuyến đường dẫn tốt hơn
        },
        "jsx": "react-jsx",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "src/**/*"
    ]
}